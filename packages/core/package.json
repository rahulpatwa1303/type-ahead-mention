{
  "name": "type-ahead-mention",
  "version": "3.0.0",
  "description": "Autocomplete for {{template.variables}} in React: prompt templates, email merge tags, and workflow builders. Nested objects, arrays, value previews, and unknown-variable highlighting.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "template",
    "template-variables",
    "variables",
    "autocomplete",
    "merge-tags",
    "handlebars",
    "mustache",
    "liquid",
    "prompt",
    "prompt-template",
    "llm",
    "placeholder",
    "mention",
    "typeahead",
    "codemirror",
    "input",
    "textarea",
    "email-template",
    "typescript"
  ],
  "author": "Rahul Patwa <rahulpatwa1303@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulpatwa1303/type-ahead-mention.git",
    "directory": "packages/core"
  },
  "homepage": "https://rahulpatwa1303.github.io/type-ahead-mention/",
  "bugs": {
    "url": "https://github.com/rahulpatwa1303/type-ahead-mention/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.30.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.0.0",
    "publint": "^0.3.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  }
}
